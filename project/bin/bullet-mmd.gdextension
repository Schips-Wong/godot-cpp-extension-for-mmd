[configuration]

entry_symbol = "bullet_mmd_library_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]

windows.editor.x86_64 = "./windows/bullet-mmd.windows.editor.x86_64.dll"
windows.debug.x86_64 = "./windows/bullet-mmd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./windows/bullet-mmd.windows.template_release.x86_64.dll"

linux.editor.x86_64 = "./linux/libbullet-mmd.linux.editor.x86_64.so"
linux.debug.x86_64 = "./linux/libbullet-mmd.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./linux/libbullet-mmd.linux.template_release.x86_64.so"

linux.editor.arm64 = "./linux/libbullet-mmd.linux.editor.arm64.so"
linux.debug.arm64 = "./linux/libbullet-mmd.linux.template_debug.arm64.so"
linux.release.arm64 = "./linux/libbullet-mmd.linux.template_release.arm64.so"

macos.editor = "./macos/libbullet-mmd.macos.editor.universal.dylib"
macos.debug = "./macos/libbullet-mmd.macos.template_debug.universal.dylib"
macos.release = "./macos/libbullet-mmd.macos.template_release.universal.dylib"
